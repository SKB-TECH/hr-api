# App
NODE_ENV=local
APP_PORT=3000

# Database (TypeORM / PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hr_api

# Disable SSL for local Postgres; set to anything other than "false" to enable
DATABASE_SSL_CONNECTION=false
# DATABASE_CA_CERT=

# Connection pool (optional, sane defaults applied if unset)
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# Redis (leave APP_REDIS_URL empty to run without Redis)
APP_REDIS_URL=
APP_REDIS_SSL_CONNECTION=false

# Google Cloud Storage (GCS)
GCS_BUCKET=your_bucket_name
GCS_PROJECT_ID=your_gcp_project_id
# Path to a service-account key JSON; omit to use Application Default Credentials
GCS_KEY_FILE=

# Amazon S3 storage (all platform uploads)
S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com
S3_REGION=eu-north-1
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY=replace_with_access_key
S3_SECRET_KEY=replace_with_secret_key
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://your_bucket_name.s3.eu-north-1.amazonaws.com

# Google Cloud Pub/Sub
# Leave PUBSUB_ENABLED unset to auto-enable outside NODE_ENV=local; set
# "false" to force-disable (no-op publish/subscribe) or "true" to force-enable.
# Project/key default to the GCS values when unset.
PUBSUB_ENABLED=
PUBSUB_PROJECT_ID=
PUBSUB_KEY_FILE=
# Set to localhost:8085 to use the local emulator (`pnpm pubsub:emulator`).
# PUBSUB_EMULATOR_HOST=localhost:8085

# JWT
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
# Zero-downtime secret rotation (optional): set CURRENT to the new secret and
# PREVIOUS to the old one; tokens signed with either verify until they expire.
# JWT_SECRET_CURRENT=
# JWT_SECRET_PREVIOUS=
# JWT_REFRESH_SECRET_CURRENT=
# JWT_REFRESH_SECRET_PREVIOUS=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# When the web app uses the Next.js proxy, Google must return through that
# proxy so it can preserve cookies and redirect to the correct dashboard.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/proxy/auth/google/callback

# Email (Resend) — leave RESEND_API_KEY empty in dev to log emails (incl. OTP) instead of sending
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@hr-api.local
# Public HTTPS URL used by email clients (defaults to WEB_APP_URL/logo/lgo.png)
EMAIL_LOGO_URL=

# Trusted hr-ia service (generate at least 32 cryptographically random characters)
HR_AI_SERVICE_TOKEN=
# Optional zero-downtime rotation. CURRENT takes over from the legacy token;
# keep PREVIOUS only until in-flight clients have switched.
HR_AI_SERVICE_TOKEN_CURRENT=
HR_AI_SERVICE_TOKEN_PREVIOUS=
HR_AI_BASE_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
HR_AI_REQUEST_TIMEOUT_MS=60000
