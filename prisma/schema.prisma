generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  email              String            @unique
  phone              String?           @unique
  password           String?
  firstName          String            @map("first_name")
  lastName           String            @map("last_name")
  role               UserRole          @default(CANDIDATE)
  status             UserStatus        @default(pending)
  provider           AuthProvider      @default(local)
  avatar             String?
  emailVerified      Boolean           @default(false) @map("email_verified")
  phoneVerified      Boolean           @default(false) @map("phone_verified")
  lastLogin          DateTime?         @map("last_login")
  twoFactorEnabled   Boolean           @default(false) @map("two_factor_enabled")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  refreshTokens      RefreshToken[]
  candidateProfile   CandidateProfile?
  companyMemberships CompanyMember[]
  auditLogs          AuditLog[]
  applications       Application[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserRole {
  CANDIDATE
  COMPANY_OWNER
  HR_MANAGER
  RECRUITER
  ADMIN
  SUPER_ADMIN
  MODERATOR
}

enum UserStatus {
  active
  suspended
  pending
  deleted
}

enum AuthProvider {
  local
  google
  linkedin
  github
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
  INTERNSHIP
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum ProfileVisibility {
  public
  recruiters_only
  private
}

enum Availability {
  immediate
  one_week
  two_weeks
  one_month
}

enum WorkType {
  remote
  onsite
  hybrid
}

model CandidateProfile {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @unique @map("user_id") @db.Uuid
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender            String?
  phone             Int?              @map("phone_number")
  birthDate         DateTime?         @map("birth_date")
  headline          String?
  bio               String?
  countryName       String?           @map("country_name")
  cityName          String?           @map("city_name")
  address           String?
  currentSalary     Decimal?          @map("current_salary") @db.Decimal(12, 2)
  expectedSalary    Decimal?          @map("expected_salary") @db.Decimal(12, 2)
  salaryCurrency    String?           @map("salary_currency")
  yearsExperience   Int?              @map("years_experience")
  linkedinUrl       String?           @map("linkedin_url")
  githubUrl         String?           @map("github_url")
  portfolioUrl      String?           @map("portfolio_url")
  availability      Availability?
  workType          WorkType?         @map("work_type")
  profileVisibility ProfileVisibility @default(public) @map("profile_visibility")
  openToWork        Boolean           @default(true) @map("open_to_work")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  resumes           Resume[]

  @@map("candidate_profiles")
}

model Resume {
  id          String           @id @default(uuid()) @db.Uuid
  candidateId String           @map("candidate_id") @db.Uuid
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String           @map("file_url")
  publicId    String           @map("public_id")
  isDefault   Boolean          @default(false) @map("is_default")
  parsed      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("resumes")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
//           APPLICATION MODULE
// ==========================================

enum ApplicationStatus {
  IN_REVIEW
  SHORTLISTED
  INTERVIEWING
  ASSESSMENT
  OFFERED
  HIRED
  DECLINED
}

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @map("job_id") @db.Uuid
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String            @map("candidate_id") @db.Uuid
  candidate        User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fullName         String            @map("full_name")
  email            String
  phone            String?
  currentJobTitle  String?           @map("current_job_title")
  linkedinUrl      String?           @map("linkedin_url")
  portfolioUrl     String?           @map("portfolio_url")
  coverLetter      String?           @map("cover_letter") @db.Text
  resumeUrl        String?           @map("resume_url")
  status           ApplicationStatus @default(IN_REVIEW)
  score            Decimal?          @db.Decimal(3, 2)
  appliedAt        DateTime          @default(now()) @map("applied_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  interviews       Interview[]

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@map("applications")
}

// ==========================================
//           INTERVIEW MODULE
// ==========================================

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Interview {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  companyId     String          @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  interviewerName String?       @map("interviewer_name")
  scheduledAt   DateTime        @map("scheduled_at")
  endTime       DateTime        @map("end_time")
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([companyId])
  @@index([scheduledAt])
  @@map("interviews")
}

// ==========================================
//               JOB MODULE
// ==========================================

enum JobStatus {
  DRAFT
  LIVE
  CLOSED
}

enum JobLevel {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR_LEVEL
  DIRECTOR
  VP_OR_ABOVE
}

enum JobCategory {
  DESIGN
  SALES
  MARKETING
  BUSINESS
  HUMAN_RESOURCE
  FINANCE
  ENGINEERING
  TECHNOLOGY
}

model Job {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id")
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  employmentType   EmploymentType @map("employment_type")
  jobLevel         JobLevel      @map("job_level")
  category         JobCategory
  location         String
  salaryMin        Decimal?      @map("salary_min") @db.Decimal(12, 2)
  salaryMax        Decimal?      @map("salary_max") @db.Decimal(12, 2)
  salaryCurrency   String        @default("USD") @map("salary_currency")
  description      String        @db.Text
  responsibilities String        @db.Text
  whoYouAre        String        @map("who_you_are") @db.Text
  niceToHaves      String?       @map("nice_to_haves") @db.Text
  capacity         Int           @default(10)
  applicationsCount Int          @default(0) @map("applications_count")
  status           JobStatus     @default(DRAFT)
  applyBefore      DateTime?     @map("apply_before")
  postedAt         DateTime?     @map("posted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  skills           JobSkill[]
  benefits         JobBenefit[]
  applications     Application[]

  @@index([status])
  @@index([category])
  @@index([jobLevel])
  @@index([employmentType])
  @@index([companyId])
  @@map("jobs")
}

model JobSkill {
  id    String @id @default(uuid()) @db.Uuid
  jobId String @map("job_id") @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name  String

  @@map("job_skills")
}

model JobBenefit {
  id          String @id @default(uuid()) @db.Uuid
  jobId       String @map("job_id") @db.Uuid
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title       String
  description String

  @@map("job_benefits")
}

// ==========================================
//               COMPANY MODULE
// ==========================================

model Company {
  id             String          @id @default(uuid())
  name           String
  slug           String?         @unique
  description    String?         @db.Text
  industry       String?
  location       String?
  foundationDate DateTime?       @map("foundation_date")
  companySize    String?         @map("company_size")
  logo           String?
  coverImage     String?         @map("cover_image")
  website        String?
  facebook       String?
  twitter        String?
  instagram      String?
  linkedin       String?
  youtube        String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  members        CompanyMember[]
  jobs           Job[]
  interviews     Interview[]

  @@map("companies")
}

model CompanyMember {
  id        String   @id @default(uuid())
  role      String
  joinedAt  DateTime @default(now()) @map("joined_at")
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("company_members")
}
