generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
  INTERNSHIP
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
  LEAD
}

model Job {
  id                  String          @id @default(uuid())
  title               String
  slug                String          @unique
  location            String
  salaryMin           Float?
  salaryMax           Float?
  description         String          @db.Text
  shortDescription    String?         @db.Text
  employmentType      EmploymentType
  experienceLevel     ExperienceLevel
  companyName         String
  isPublished         Boolean         @default(true)
  applicationUrl      String?
  deadline            DateTime?
  heroBackgroundImage String?         @map("hero_background_image")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // The new relationship to the JobApplication model
  applications        JobApplication[]

  @@index([slug])
  @@index([isPublished])
  @@map("jobs")
}

model HeroImage {
  id        String   @id @default(uuid())
  secureUrl String   @map("secure_url")
  publicId  String   @map("public_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_images")
}

// The newly added JobApplication model
model JobApplication {
  id          String   @id @default(uuid())
  jobId       String   @map("job_id")
  fullName    String   @map("full_name")
  email       String
  phone       String
  coverLetter String   @db.Text @map("cover_letter")
  resumeUrl   String?  @map("resume_url")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationship back to the Job model
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_applications")
}